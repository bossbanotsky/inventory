{
  "entities": {
    "Item": {
      "title": "Item",
      "description": "An inventory item.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "itemType": { "type": "string", "enum": ["COUNTABLE", "LENGTH", "WEIGHT", "VOLUME"] },
        "baseUnit": { "type": "string" },
        "piecesPerUnit": { "type": "number" },
        "lengthPerUnit": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "density": { "type": "number" },
        "lowStockThreshold": { "type": "number" },
        "createdAt": { "type": "number" },
        "totalPieces": { "type": "number" }
      },
      "required": ["name", "itemType", "baseUnit", "piecesPerUnit", "createdAt", "totalPieces"]
    },
    "Receiver": {
      "title": "Receiver",
      "description": "A person or entity that receives items.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "department": { "type": "string" }
      },
      "required": ["name"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A transaction log for incoming or outgoing inventory.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["RECEIVE", "DISBURSE", "ADJUSTMENT"] },
        "itemId": { "type": "string" },
        "receiverId": { "type": "string" },
        "pieceQuantity": { "type": "number" },
        "inputQuantity": { "type": "number" },
        "inputUom": { "type": "string" },
        "displayString": { "type": "string" },
        "notes": { "type": "string" },
        "batchNumber": { "type": "string" },
        "receivedBy": { "type": "string" }
      },
      "required": ["date", "type", "itemId", "pieceQuantity", "inputQuantity", "inputUom", "displayString", "notes"]
    }
  },
  "firestore": {
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/Item" },
      "description": "Stores inventory items."
    },
    "/receivers/{receiverId}": {
      "schema": { "$ref": "#/entities/Receiver" },
      "description": "Stores receivers."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Stores all transactions globally."
    }
  }
}
