rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} { allow read, write: if false; }

    function isSignedIn() { 
      return request.auth != null && request.auth.token.email_verified == true; 
    }
    
    function isAdmin() { return isSignedIn(); } 
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidItem(data) {
      return data.keys().hasAll(['name', 'itemType', 'baseUnit', 'piecesPerUnit', 'createdAt', 'totalPieces'])
        && data.size() >= 6 && data.size() <= 12
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.itemType is string && data.itemType in ['COUNTABLE', 'LENGTH', 'WEIGHT', 'VOLUME']
        && data.baseUnit is string && data.baseUnit.size() > 0 && data.baseUnit.size() <= 50
        && data.piecesPerUnit is number
        && data.createdAt is number
        && data.totalPieces is number
        && (!data.keys().hasAny(['lowStockThreshold']) || data.lowStockThreshold == null || data.lowStockThreshold is number)
        && (!data.keys().hasAny(['lengthPerUnit']) || data.lengthPerUnit == null || data.lengthPerUnit is number)
        && (!data.keys().hasAny(['width']) || data.width == null || data.width is number)
        && (!data.keys().hasAny(['height']) || data.height == null || data.height is number)
        && (!data.keys().hasAny(['density']) || data.density == null || data.density is number);
    }

    function isValidReceiver(data) {
      return data.keys().hasAll(['name'])
        && data.size() >= 1 && data.size() <= 3
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (!data.keys().hasAny(['department']) || data.department == null || (data.department is string && data.department.size() <= 200));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['date', 'type', 'itemId', 'pieceQuantity', 'inputQuantity', 'inputUom', 'displayString', 'notes'])
        && data.size() >= 8 && data.size() <= 12
        && data.date is string && data.date.size() > 0 && data.date.size() <= 100
        && data.type is string && data.type in ['RECEIVE', 'DISBURSE', 'ADJUSTMENT']
        && data.itemId is string && data.itemId.size() > 0 && data.itemId.size() <= 128
        && data.pieceQuantity is number
        && data.inputQuantity is number
        && data.inputUom is string && data.inputUom.size() <= 50
        && data.displayString is string && data.displayString.size() <= 500
        && data.notes is string && data.notes.size() <= 2000
        && (!data.keys().hasAny(['receiverId']) || data.receiverId == null || (data.receiverId is string && data.receiverId.size() <= 128))
        && (!data.keys().hasAny(['batchNumber']) || data.batchNumber == null || (data.batchNumber is string && data.batchNumber.size() <= 128))
        && (!data.keys().hasAny(['receivedBy']) || data.receivedBy == null || (data.receivedBy is string && data.receivedBy.size() <= 128));
    }

    match /items/{itemId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(itemId);
      allow create: if isAdmin() && isValidId(itemId) && isValidItem(incoming());
      allow update: if isAdmin() && isValidId(itemId) && isValidItem(incoming());
      allow delete: if isAdmin() && isValidId(itemId);
    }
    
    match /receivers/{receiverId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(receiverId);
      allow create: if isAdmin() && isValidId(receiverId) && isValidReceiver(incoming());
      allow update: if isAdmin() && isValidId(receiverId) && isValidReceiver(incoming());
      allow delete: if isAdmin() && isValidId(receiverId);
    }

    match /transactions/{transactionId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(transactionId);
      allow create: if isAdmin() && isValidId(transactionId) && isValidTransaction(incoming())
        && exists(/databases/$(database)/documents/items/$(incoming().itemId));
      allow update: if isAdmin() && isValidId(transactionId) && isValidTransaction(incoming());
      allow delete: if isAdmin() && isValidId(transactionId);
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
